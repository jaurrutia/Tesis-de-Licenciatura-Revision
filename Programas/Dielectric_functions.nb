    RowBox[{
     RowBox[{"fit321", "[", "\"\<BestFitParameters\>\"", "]"}], ",", "3"}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"fit321Values", "=", 
    RowBox[{"Values", "[", 
     RowBox[{"fit321", "[", "\"\<BestFitParameters\>\"", "]"}], 
