Cell[BoxData[{
 RowBox[{
  RowBox[{"parteIm028", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"fit28", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1.19", ",", "4.96", ",", "0.01"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parteIm02810", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"fit28", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "omega10"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"omegaprueba28", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"1.19", ",", "4.96", ",", "0.01"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"datosRealObjetivo28", "=", 
   RowBox[{"eps28Re", "/@", "omegaprueba28"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"                  ", 
  RowBox[{
   RowBox[{
    RowBox[{"funcionError28", "[", 
     RowBox[{"w_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"epsAnchor", ",", "espectro", ",", "dif"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "valor", " ", "de", " ", "epsReal", " ", "en", " ", "el", " ", 
        "ancla"}], "*)"}], "\[IndentingNewLine]", "                  ", 
      RowBox[{
       RowBox[{"epsAnchor", "=", 
        RowBox[{"eps28Re", "[", "w", "]"}]}], ";", "\[IndentingNewLine]", 
       "                    ", 
       RowBox[{"(*", 
        RowBox[{"ejecutar", " ", "modelo"}], "*)"}], 
       RowBox[{"espectro", "=", 
        RowBox[{"sskkrebook", "[", 
         RowBox[{
         "omegaprueba28", ",", "parteIm028", ",", "w", ",", "epsAnchor"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "                      ", 
       RowBox[{"(*", 
        RowBox[{"error", " ", "cuadr\[AAcute]tico", " ", "total"}], "*)"}], 
       RowBox[{"dif", "=", 
        RowBox[{"espectro", "-", "datosRealObjetivo28"}]}], ";", 
       "\[IndentingNewLine]", "                    ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"dif", "^", "2"}], "]"}], "/", 
         RowBox[{"Length", "[", "datosRealObjetivo28", "]"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\n", "                    "}], "\n", 
 RowBox[{
  RowBox[{"error28", "=", 
