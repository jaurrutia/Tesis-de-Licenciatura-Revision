Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "van", " ", "a", " ", "importar", " ", "los", " ", "datos", " ",
     "de", " ", "la", " ", "parte", " ", "real", " ", "e", " ", "imaginaria", 
    " ", "del", " ", "\[IAcute]ndice", " ", "de", " ", "refracci\[OAcute]n"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"datos0Im", "=", 
     RowBox[{
     "Import", "[", 
      "\"\<C:\\\\Users\\\\danal\\\\Documents\\\\Grupo_Nanoplasm\[OAcute]nica\\\
\\Tesis\\\\Refractive index\\\\28.7_k_ImN_Erythrocytes.csv\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Se", " ", "eliminan", " ", "los", " ", "encabezados", " ", "de", " ", 
     "los", " ", "datos"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos1Im", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"datos0Im", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Se", " ", "pasa", " ", "de", " ", "longitudes", " ", "de", " ", "onda", 
     " ", "a", " ", "energ\[IAcute]as", " ", "y", " ", "se", " ", "toma", " ",
      "a", " ", "la", " ", "primera", " ", "columna", " ", "como", " ", "el", 
     " ", "vector", " ", "de", " ", "energ\[IAcute]as"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos2Im", "=", 
     RowBox[{"h", " ", 
      RowBox[{"c", "/", 
       RowBox[{"datos1Im", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Se", " ", "interpolan", " ", "los", " ", "datos", " ", "de", " ", "la", 
     " ", "parte", " ", "imaginaria", " ", "y", " ", "real"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"parteIm280", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"datos2Im", ",", 
        RowBox[{"datos1Im", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"parteIm28", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"parteIm280", ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"parteRe28", "[", "x_", "]"}], ":=", 
     RowBox[{"parteRe", "[", 
      RowBox[{"x", ",", "28.7"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"parteIm28", "[", "x", "]"}], ",", 
