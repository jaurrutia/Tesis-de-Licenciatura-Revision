Cell[CellGroupData[{

Cell["Todas las concentraciones", "Section",
 CellChangeTimes->{{3.9852071575784903`*^9, 
  3.985207167352631*^9}},ExpressionUUID->"38c3d565-3d26-40ed-9f32-\
d08f17942284"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h2olambda", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"datos1H2O", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "*", "1000"}], ",", 
       RowBox[{"datos1H2O", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"betalambda", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"datos1Beta", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
