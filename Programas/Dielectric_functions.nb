Cell[CellGroupData[{

Cell["Importaci\[OAcute]n de datos", "Subsection",
 CellChangeTimes->{{3.9851914558803196`*^9, 
  3.9851914624929285`*^9}},ExpressionUUID->"9b34c52a-ca09-438e-8319-\
7bdf3b14aaf5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"datosuA30", "=", 
    RowBox[{
    "Import", "[", 
     "\"\<C:\\\\Users\\\\danal\\\\Documents\\\\Grupo_Nanoplasm\[OAcute]nica\\\
\\Tesis\\\\Refractive index\\\\30.6_uA_Erythrocytes.csv\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "eliminan", " ", "los", " ", "encabezados", " ", "de", " ", 
    "los", " ", "datos"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"datos1uA30", "=", 
    RowBox[{"Drop", "[", 
     RowBox[{"datosuA30", ",", "1"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "pasa", " ", "de", " ", "longitudes", " ", "de", " ", "onda", 
    " ", "a", " ", "energ\[IAcute]as", " ", "y", " ", "se", " ", "toma", " ", 
    "a", " ", "la", " ", "primera", " ", "columna", " ", "como", " ", "el", 
    " ", "vector", " ", "de", " ", "energ\[IAcute]as"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"datos2im30", "=", 
    RowBox[{"h", " ", 
     RowBox[{"c", "/", 
      RowBox[{"datos1uA30", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Obtener", " ", "la", " ", "parte", " ", "imaginariad", " ", "del", " ", 
    "\[IAcute]ndice", " ", "de", " ", "refracci\[OAcute]n", " ", "a", " ", 
    "partir", " ", "del", " ", "coeficiente", " ", "de", " ", 
    "absorci\[OAcute]n"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"datos3im30", "=", 
    RowBox[{
     RowBox[{"datos1uA30", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "*", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "6"}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"datos1uA30", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", "Pi"}], ")"}]}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "interpolan", " ", "los", " ", "datos", " ", "de", " ", "la", 
    " ", "parte", " ", "imaginaria"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parteIm300", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"datos1uA30", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "datos3im30"}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parteIm30", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"datos2im30", ",", "datos3im30"}], "}"}], "]"}], ",", 
     RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parteRe30", "[", "x_", "]"}], ":=", 
   RowBox[{"parteRe", "[", 
    RowBox[{"x", ",", "30.6"}], "]"}]}], "\n"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"parteIm30", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "2.11", ",", "4.95"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"parteRe30", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1.15", ",", "4.95"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Code",
 CellChangeTimes->{{3.98519132371327*^9, 3.9851913249046607`*^9}, {
