  RowBox[{"datosRealObjetivo32", "=", 
   RowBox[{"eps32Re", "/@", "omegaprueba32"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"                  ", 
  RowBox[{
   RowBox[{
    RowBox[{"funcionError32", "[", 
     RowBox[{"w_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"epsAnchor", ",", "espectro", ",", "dif"}], "}"}], ",", 
