Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Funci\[OAcute]n", " ", "diel\[EAcute]ctrica", " ", "experimental"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"epsPlasmaIm", "[", "x_", "]"}], ":=", 
     RowBox[{"Im", "[", 
      RowBox[{"eps", "[", 
       RowBox[{"parteRePlasma", ",", "parteImPlasma", ",", "x"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"epsPlasmaRe", "[", "x_", "]"}], ":=", 
     RowBox[{"Re", "[", 
      RowBox[{"eps", "[", 
       RowBox[{"parteRePlasma", ",", "parteImPlasma", ",", "x"}], "]"}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Intervalos", " ", "de", " ", "b\[UAcute]squeda", " ", "de", " ", "los", 
     " ", "m\[AAcute]ximos"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intervalosPlasma", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1.2", ",", "1.3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2.57", ",", "2.8"}], "}"}], ",", 
