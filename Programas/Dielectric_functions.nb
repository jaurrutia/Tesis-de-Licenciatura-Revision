 RowBox[{
  RowBox[{"datosRealObjetivo292", "=", 
   RowBox[{"eps292Re", "/@", "omegaprueba292"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"                  ", 
  RowBox[{
   RowBox[{
    RowBox[{"funcionError292", "[", 
     RowBox[{"w_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
