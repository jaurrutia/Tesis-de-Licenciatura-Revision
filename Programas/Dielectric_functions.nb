Cell[CellGroupData[{

Cell[TextData[{
 "\[LineSeparator]C\[AAcute]lculo FWHM",
 Cell[BoxData["  "],ExpressionUUID->"480cc290-5302-44df-bd92-33202136e1a2"]
}], "Subsection",
 CellChangeTimes->{{3.9920186165395746`*^9, 3.9920186215470643`*^9}, 
   3.995325045757741*^9},ExpressionUUID->"13d2da69-3b04-4379-8a07-\
2bee31f4b2f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "Definimos", " ", "el", " ", "modelo", " ", 
    "matem\[AAcute]tico", " ", "de", " ", "la", " ", "Gaussiana", " ", "con", 
    " ", "un", " ", 
    RowBox[{"offset", " ", "'"}], 
    RowBox[{"b", "'"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"modelo", " ", "=", " ", 
     RowBox[{
      RowBox[{"a", " ", "*", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", " ", "-", " ", "x0"}], ")"}], "^", "2"}]}], " ", "/",
          " ", 
         RowBox[{"(", 
          RowBox[{"2", " ", "*", " ", 
           RowBox[{"sigma", "^", "2"}]}], ")"}]}], "]"}]}], " ", "+", " ", 
      "b"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"2.", " ", "Ejecutamos", " ", "el", " ", "ajuste"}], " ", "*)"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"NOTA", ":", " ", 
     RowBox[{
     "Es", " ", "muy", " ", "recomendable", " ", "que", " ", "cambies", " ", 
      "los", " ", "valores", " ", "aproximados", " ", "iniciales", " ", 
      RowBox[{"(", 
       RowBox[{"1", ",", " ", "0", ",", " ", "1", ",", " ", "0"}], ")"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "por", " ", "estimaciones", " ", "reales", " ", "de", " ", "tus", " ", 
      "datos"}], ",", " ", 
     RowBox[{"por", " ", 
      RowBox[{"ejemplo", ":", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", 
          RowBox[{"Max", "[", "datos", "]"}]}], "}"}], " ", "o", " ", 
        RowBox[{"{", 
         RowBox[{"x0", ",", " ", 
          RowBox[{"posici\[OAcute]n_del", "_pico"}]}], "}"}]}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"ajuste", " ", "=", " ", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"parteIm300", ",", " ", "modelo", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x0", ",", " ", "415"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"sigma", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", "x"}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "3.", " ", "Extraemos", " ", "los", " ", "par\[AAcute]metros", " ", 
     "optimizados", " ", "usando", " ", "reglas", " ", "de", " ", 
     "sustituci\[OAcute]n"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "bestA", ",", " ", "bestX0", ",", " ", "bestSigma", ",", " ", "bestB"}], 
     "}"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "x0", ",", " ", "sigma", ",", " ", "b"}], "}"}], 
     " ", "/.", " ", 
     RowBox[{"ajuste", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "4.", " ", "Calculamos", " ", "el", " ", "FWHM", " ", "anal\[IAcute]tico",
      " ", "a", " ", "partir", " ", "de", " ", "la", " ", "sigma", " ", 
     "\[OAcute]ptima"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"fwhm", " ", "=", " ", 
     RowBox[{"2", " ", "*", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "*", " ", 
        RowBox[{"Log", "[", "2", "]"}]}], "]"}], " ", "*", " ", 
      "bestSigma"}]}], ";"}], "\n", "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<El FWHM de los datos ajustados es: \>\"", ",", " ", "fwhm"}],
     "]"}]}]}]], "Code",
 CellChangeTimes->{{3.9920186933813086`*^9, 3.9920187567107334`*^9}, {
   3.9920188204152713`*^9, 3.9920188637936296`*^9}, 3.9920189858351116`*^9, {
   3.992019094749655*^9, 3.992019097083137*^9}},
 CellLabel->
  "In[706]:=",ExpressionUUID->"5413b4fa-2706-4713-a751-e001107d0157"],

