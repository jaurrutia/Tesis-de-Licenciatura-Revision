        RowBox[{"2.8", ",", "2.9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3.4", ",", "3.5"}], "}"}]}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"\[Omega]0iPlasma", "=", 
     RowBox[{"\[Omega]0i", "[", 
      RowBox[{"epsPlasmaIm", ",", "intervalosPlasma", ",", "tolRes"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
